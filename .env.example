# ─── Sofa Time HUB — variabili d'ambiente di esempio ─────────────────────────
# Copia questo file in `.env` (o imposta le variabili su Render → Environment)
# e compila solo quelle che ti servono. NON committare mai il file `.env` reale.

# ── Sorgente watchlist (scegline almeno una) ────────────────────────────────
# Percorso locale del file di backup Sofa Time
SOFATIME_BACKUP_PATH=./sofatime_backup.json
# Oppure link URL/Gist al backup (ha priorità sul file locale)
SOFATIME_BACKUP_URL=
# Minuti tra un refresh automatico del backup da URL e il successivo (0 = disattiva)
BACKUP_REFRESH_MIN=30

# ── Unica integrazione Trakt del server ─────────────────────────────────────
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
# Deve coincidere con l'URI configurato nell'app Trakt.
TRAKT_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
# Token utente ottenuti col device flow (obbligatori su Render).
TRAKT_ACCESS_TOKEN=
TRAKT_REFRESH_TOKEN=

# ── Arricchimento metadati (chiavi gratuite/condivise, sovrascrivibili) ──────
TMDB_KEY=
RPDB_KEY=

# ── Scrobbler Stremio (opzionale) ───────────────────────────────────────────
# Preferito: auth key Stremio. Email/password restano un fallback.
STREMIO_AUTHKEY=
STREMIO_EMAIL=
STREMIO_PASSWORD=
# Token condiviso col client Nuvio modificato per proteggere POST /api/scrobble.
SCROBBLE_TOKEN=

# ── Server / deploy ─────────────────────────────────────────────────────────
# URL pubblico dell'addon (es. https://sofa-time-hub.onrender.com)
ADDON_URL=
PORT=7780

# ── Sicurezza (opzionale) ───────────────────────────────────────────────────
# Cifra il token Trakt a riposo su disco
TOKEN_ENC_KEY=
# Protegge /clear-cache e /backup-refresh
CLEAR_CACHE_TOKEN=
# Protegge l'upload del backup: poi usa /upload?token=IL_TUO_TOKEN
UPLOAD_TOKEN=

# ── Upload backup sul Gist (opzionale) ──────────────────────────────────────
GITHUB_GIST_ID=
GITHUB_GIST_TOKEN=
