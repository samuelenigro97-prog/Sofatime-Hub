# ─── Sofa Time HUB — variabili d'ambiente di esempio ─────────────────────────
# Copia questo file in `.env` (o imposta le variabili su Render → Environment)
# e compila solo quelle che ti servono. NON committare mai il file `.env` reale.

# ── Sorgente watchlist (scegline almeno una) ────────────────────────────────
# Percorso locale del file di backup Sofa Time
SOFATIME_BACKUP_PATH=./sofatime_backup.json
# Oppure link URL/Gist al backup (ha priorità sul file locale)
SOFATIME_BACKUP_URL=
# Minuti tra un refresh automatico del backup da URL e il successivo (0 = disattiva)
BACKUP_REFRESH_MIN=30

# ── Live Sync via Simkl (opzionale) ─────────────────────────────────────────
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
# Token utente ottenuto col PIN flow (obbligatorio su Render se usi Simkl)
SIMKL_ACCESS_TOKEN=

# ── Arricchimento metadati (chiavi gratuite/condivise, sovrascrivibili) ──────
TMDB_KEY=
RPDB_KEY=

# ── Scrobbler Stremio (opzionale) ───────────────────────────────────────────
# Credenziali PERSONALI dell'account Stremio: impostale solo qui, mai nel codice.
STREMIO_EMAIL=
STREMIO_PASSWORD=

# ── Server / deploy ─────────────────────────────────────────────────────────
# URL pubblico dell'addon (es. https://sofa-time-hub.onrender.com)
ADDON_URL=
PORT=7780

# ── Sicurezza (opzionale) ───────────────────────────────────────────────────
# Cifra il token Simkl a riposo su disco
TOKEN_ENC_KEY=
# Protegge /clear-cache e /backup-refresh
CLEAR_CACHE_TOKEN=
# Protegge l'upload del backup: poi usa /upload?token=IL_TUO_TOKEN
UPLOAD_TOKEN=

# ── Upload backup sul Gist (opzionale) ──────────────────────────────────────
GITHUB_GIST_ID=
GITHUB_GIST_TOKEN=

# ── YouTube Subscription Sync (opzionale, demone separato: npm run youtube-sync) ──
# Credenziali OAuth di un progetto Google Cloud con "YouTube Data API v3" abilitata
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# Deve combaciare con il redirect URI configurato sul client OAuth (default: locale)
YT_REDIRECT_URI=http://localhost:8090/oauth2callback
# Refresh token dei due account (ottenuti con `npm run youtube-auth -- account1` / `account2`,
# oppure incollati qui direttamente per un deploy remoto senza rifare l'auth interattiva)
YT_ACCOUNT1_REFRESH_TOKEN=
YT_ACCOUNT2_REFRESH_TOKEN=
# Minuti tra un controllo e il successivo
YT_SYNC_INTERVAL_MIN=15
